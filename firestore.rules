rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // GLOBAL DEFAULT DENY
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // HELPER FUNCTIONS
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Super Admin is verified strictly via the console-managed /platform_admins/{uid} document
    // Never by client-side email matching
    function isSuperAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/platform_admins/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/platform_admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    function getShop(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data;
    }

    function shopExists(shopId) {
      return exists(/databases/$(database)/documents/shops/$(shopId));
    }

    function isInvitedStaffOnShopData(shopData) {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        ('invitedStaffEmails' in shopData) &&
        shopData.invitedStaffEmails is list &&
        (request.auth.token.email in shopData.invitedStaffEmails);
    }

    function isShopOwner(shopId) {
      return isAuthenticated() && shopExists(shopId) && (
        getShop(shopId).ownerUid == request.auth.uid ||
        (getShop(shopId).memberRoles != null && getShop(shopId).memberRoles[request.auth.uid] == 'shop_owner')
      );
    }

    function isShopManager(shopId) {
      return isAuthenticated() && shopExists(shopId) && (
        isShopOwner(shopId) ||
        (getShop(shopId).memberRoles != null && getShop(shopId).memberRoles[request.auth.uid] == 'manager')
      );
    }

    function isShopSalesman(shopId) {
      return isAuthenticated() && shopExists(shopId) && (
        isShopManager(shopId) ||
        (getShop(shopId).memberRoles != null && getShop(shopId).memberRoles[request.auth.uid] == 'salesman') ||
        (getShop(shopId).memberUids != null && request.auth.uid in getShop(shopId).memberUids) ||
        isInvitedStaffOnShopData(getShop(shopId))
      );
    }

    function isShopMember(shopId) {
      return isShopSalesman(shopId);
    }

    // Enforce active/grace/pending subscription for store write mutations
    function isShopSubscriptionActive(shopId) {
      return !('subscription' in getShop(shopId)) ||
        getShop(shopId).subscription.status in ['active', 'grace', 'pending'];
    }

    // Validation Helpers
    function isValidUserCreate(userId, data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'shopId', 'createdAt']) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.role in ['shop_owner', 'manager', 'salesman'] &&
        data.shopId is string && data.shopId.size() >= 1 && data.shopId.size() <= 120 &&
        data.createdAt is string;
    }

    function isValidUserSelfUpdate(newData, oldData) {
      // User can never change their uid, createdAt, role, or shopId once bound
      return newData.uid == oldData.uid &&
        newData.createdAt == oldData.createdAt &&
        newData.role == oldData.role &&
        newData.shopId == oldData.shopId &&
        newData.role in ['shop_owner', 'manager', 'salesman'] &&
        newData.name is string && newData.name.size() >= 1 && newData.name.size() <= 120;
    }

    function isValidShopCreate(shopId, data) {
      return data.keys().hasAll(['id', 'name', 'ownerUid', 'ownerName', 'ownerPhone', 'category', 'memberUids', 'memberRoles', 'createdAt']) &&
        data.id == shopId &&
        data.ownerUid == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
        data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 120 &&
        data.ownerPhone is string && data.ownerPhone.size() <= 30 &&
        data.category in ['jersey', 'clothing', 'hybrid'] &&
        data.memberUids is list &&
        request.auth.uid in data.memberUids &&
        data.memberRoles is map &&
        data.memberRoles[request.auth.uid] == 'shop_owner';
    }

    function isValidShopOwnerUpdate(newData, oldData) {
      // Shop Owner cannot change shop id, ownerUid, createdAt, category, or self-approve subscription plan/status/expiry
      let unchangedCore = newData.id == oldData.id &&
        newData.ownerUid == oldData.ownerUid &&
        newData.createdAt == oldData.createdAt &&
        newData.category == oldData.category &&
        (!('shopCategory' in oldData) || newData.shopCategory == oldData.shopCategory) &&
        (oldData.ownerUid in newData.memberUids) &&
        newData.memberRoles[oldData.ownerUid] == 'shop_owner';

      let subscriptionSafe = !('subscription' in oldData) || (
        'subscription' in newData &&
        newData.subscription.plan == oldData.subscription.plan &&
        newData.subscription.expiresAt == oldData.subscription.expiresAt &&
        newData.subscription.graceEndsAt == oldData.subscription.graceEndsAt &&
        (newData.subscription.status == oldData.subscription.status || newData.subscription.status == 'pending')
      );

      return unchangedCore && subscriptionSafe;
    }

    // Allow an invited staff member to link ONLY their own Firebase Auth UID into memberUids & memberRoles
    function isValidInvitedStaffSelfLink(newData, oldData) {
      return isInvitedStaffOnShopData(oldData) &&
        newData.diff(oldData).affectedKeys().hasOnly(['memberUids', 'memberRoles']) &&
        newData.id == oldData.id &&
        newData.ownerUid == oldData.ownerUid &&
        newData.createdAt == oldData.createdAt &&
        newData.subscription == oldData.subscription &&
        (oldData.ownerUid in newData.memberUids) &&
        (request.auth.uid in newData.memberUids) &&
        newData.memberUids.size() <= oldData.memberUids.size() + 1 &&
        newData.memberRoles[oldData.ownerUid] == 'shop_owner' &&
        newData.memberRoles[request.auth.uid] in ['salesman', 'manager'];
    }

    // ===============================================================
    // 1. PLATFORM SUPER ADMINS (Console-Only Write)
    // ===============================================================
    match /platform_admins/{adminUid} {
      allow get: if isAuthenticated() && (request.auth.uid == adminUid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ===============================================================
    // 2. USER PROFILES (/users/{userId})
    // ===============================================================
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidUserCreate(userId, request.resource.data);
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && isValidUserSelfUpdate(request.resource.data, resource.data)) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // ===============================================================
    // 3. STAFF INVITATIONS (/staff_invitations/{inviteId})
    // ===============================================================
    match /staff_invitations/{inviteId} {
      allow get, list: if isAuthenticated() && (
        (request.auth.token.email != null && resource.data.email == request.auth.token.email) ||
        isShopManager(resource.data.shopId) ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.shopId is string &&
        isShopOwner(request.resource.data.shopId) &&
        request.resource.data.role in ['manager', 'salesman'];
      allow update: if isAuthenticated() && (
        isShopOwner(resource.data.shopId) ||
        (
          request.auth.token.email != null &&
          resource.data.email == request.auth.token.email &&
          request.resource.data.shopId == resource.data.shopId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.acceptedByUid == request.auth.uid
        ) ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (isShopOwner(resource.data.shopId) || isSuperAdmin());
    }

    // ===============================================================
    // 4. TENANT SHOPS (/shops/{shopId}) & ISOLATED SUBCOLLECTIONS
    // ===============================================================
    match /shops/{shopId} {
      allow get, list: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
        isInvitedStaffOnShopData(resource.data) ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && isValidShopCreate(shopId, request.resource.data);
      allow update: if isAuthenticated() && (
        (resource.data.ownerUid == request.auth.uid && isValidShopOwnerUpdate(request.resource.data, resource.data)) ||
        isValidInvitedStaffSelfLink(request.resource.data, resource.data) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();

      // 4A. Products / Inventory (Shared catalog; confidential buying costs isolated in /private_costs)
      match /products/{productId} {
        allow read: if isShopMember(shopId) || isSuperAdmin();
        allow create: if (
          (isShopOwner(shopId) && isShopSubscriptionActive(shopId)) ||
          isSuperAdmin() ||
          (
            // Authorized Staff (Manager / Salesman) can add products, categories, sizes, colors, selling MRP, bottomPrice, and stock,
            // but cannot inject confidential buying cost into shared product documents
            isShopSalesman(shopId) &&
            isShopSubscriptionActive(shopId) &&
            (!('lotCostLandingPrice' in request.resource.data) || request.resource.data.lotCostLandingPrice == 0)
          )
        ) &&
          request.resource.data.shopId == shopId &&
          request.resource.data.id == productId;
        allow update: if (
          (isShopOwner(shopId) && isShopSubscriptionActive(shopId)) ||
          isSuperAdmin() ||
          (
            // Authorized Staff (Manager / Salesman) can update stock, sizes, colors, and MRP,
            // but can NEVER overwrite or tamper with lotCostLandingPrice or bottomPrice
            isShopSalesman(shopId) &&
            isShopSubscriptionActive(shopId) &&
            request.resource.data.lotCostLandingPrice == resource.data.lotCostLandingPrice &&
            request.resource.data.bottomPrice == resource.data.bottomPrice
          )
        ) &&
          request.resource.data.shopId == shopId &&
          request.resource.data.id == resource.data.id;
        allow delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // 4A-2. Confidential Buying Costs Vault (Strictly Owner & Super Admin only)
      match /private_costs/{costDocId} {
        allow read, create, update, delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // 4B. Invoices & Sales
      match /invoices/{invoiceId} {
        allow read: if isShopMember(shopId) || isSuperAdmin();
        allow create: if ((isShopSalesman(shopId) && isShopSubscriptionActive(shopId)) || isSuperAdmin()) &&
          request.resource.data.shopId == shopId &&
          request.resource.data.id == invoiceId &&
          request.resource.data.total is number &&
          request.resource.data.total >= 0 &&
          (
            // Direct client writes by ordinary salesmen cannot bypass bottom-price policy:
            // Invoices with below-floor discounts must be created through the trusted backend or by the Shop Owner
            request.resource.data.hasBelowFloorDiscount != true ||
            isShopOwner(shopId) ||
            isSuperAdmin()
          );
        allow update: if (
          ((isShopManager(shopId) && isShopSubscriptionActive(shopId)) || isSuperAdmin()) &&
          request.resource.data.shopId == shopId &&
          request.resource.data.id == resource.data.id
        ) || (
          // Salesman can record due recovery or print status update, cannot alter invoice total or shopId
          isShopSalesman(shopId) &&
          isShopSubscriptionActive(shopId) &&
          request.resource.data.shopId == shopId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.total == resource.data.total
        );
        allow delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // 4C. Daily Expenses
      match /expenses/{expenseId} {
        allow read: if isShopMember(shopId) || isSuperAdmin();
        allow create: if ((isShopSalesman(shopId) && isShopSubscriptionActive(shopId)) || isSuperAdmin()) &&
          request.resource.data.shopId == shopId &&
          request.resource.data.id == expenseId &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0;
        allow update, delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // 4D. Multi-Drawers & Drawer Transactions
      match /drawers/{drawerDocId} {
        allow read: if isShopOwner(shopId) ||
          isSuperAdmin() ||
          (drawerDocId == 'transactions' && isShopManager(shopId));
        allow create, update: if (
          ((isShopManager(shopId) && isShopSubscriptionActive(shopId)) || isSuperAdmin()) &&
          request.resource.data.shopId == shopId
        ) || (
          // Salesman can append POS sale/expense transactions into drawer state, but cannot read full drawer balances or delete drawers
          isShopSalesman(shopId) &&
          isShopSubscriptionActive(shopId) &&
          request.resource.data.shopId == shopId &&
          drawerDocId in ['balances', 'transactions']
        );
        allow delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // 4E. Staff Members (Non-owner staff may only read their own record; never list/view other staff PINs or hashes)
      match /staff/{staffId} {
        allow get, list: if isShopOwner(shopId) ||
          isSuperAdmin() ||
          (
            isShopMember(shopId) &&
            (
              resource.data.get('uid', '') == request.auth.uid ||
              (request.auth.token.email != null && resource.data.get('email', '') == request.auth.token.email)
            )
          );
        allow create, update, delete: if (isShopOwner(shopId) || isSuperAdmin()) &&
          (request.method == 'delete' || request.resource.data.shopId == shopId);
      }

      // 4F. Resellers / Wholesale Ledger
      match /resellers/{resellerId} {
        allow read: if isShopMember(shopId) || isSuperAdmin();
        allow create, update: if ((isShopSalesman(shopId) && isShopSubscriptionActive(shopId)) || isSuperAdmin()) &&
          request.resource.data.shopId == shopId;
        allow delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // 4G. Custom Orders (Alterations, Team Bulk, Standalone Font Orders)
      match /orders/{orderId} {
        allow read: if isShopMember(shopId) || isSuperAdmin();
        allow create, update: if ((isShopSalesman(shopId) && isShopSubscriptionActive(shopId)) || isSuperAdmin()) &&
          request.resource.data.shopId == shopId;
        allow delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // 4G-2. Shop-Scoped Customer Profiles & Loyalty Balances
      match /customers/{customerId} {
        allow read: if isShopMember(shopId) || isSuperAdmin();
        allow create, update: if ((isShopSalesman(shopId) && isShopSubscriptionActive(shopId)) || isSuperAdmin()) &&
          request.resource.data.shopId == shopId &&
          request.resource.data.id == customerId &&
          request.resource.data.loyaltyPoints is number &&
          request.resource.data.loyaltyPoints >= 0;
        allow delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // 4G-3. Shop-Scoped Loyalty Transactions Ledger
      match /loyalty_transactions/{txId} {
        allow read: if isShopMember(shopId) || isSuperAdmin();
        allow create: if ((isShopSalesman(shopId) && isShopSubscriptionActive(shopId)) || isSuperAdmin()) &&
          request.resource.data.shopId == shopId &&
          request.resource.data.id == txId &&
          request.resource.data.points is number &&
          request.resource.data.points >= 0 &&
          request.resource.data.balanceAfter is number &&
          request.resource.data.balanceAfter >= 0;
        allow update, delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // 4G-4. Shop-Scoped Stock Adjustment Ledger
      match /stock_adjustments/{adjId} {
        allow read: if isShopMember(shopId) || isSuperAdmin();
        allow create: if ((isShopSalesman(shopId) && isShopSubscriptionActive(shopId)) || isSuperAdmin()) &&
          request.resource.data.shopId == shopId &&
          request.resource.data.id == adjId &&
          request.resource.data.newQty is number &&
          request.resource.data.newQty >= 0 &&
          request.resource.data.reason is string &&
          request.resource.data.reason.size() > 0;
        allow update, delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // 4H. Store Auxiliary State (Explicit Document-Specific RBAC)
      match /data/{docId} {
        allow read: if (
          // Confidential Owner-Only documents: Partners, Owner Ledger, Monthly Profit/COGS Audits, Trash, Security Audit Logs, API Secrets, Private Costs
          docId in ['owners', 'ownerTxs', 'owner_txs', 'monthlyAudits', 'monthly_audits', 'trash', 'audit_logs', 'api_config', 'private_costs']
            ? (isShopOwner(shopId) || isSuperAdmin())
            : (
                // Z-Reports readable by Owner, Manager, or Super Admin
                docId in ['zReports', 'z_reports']
                  ? (isShopOwner(shopId) || isShopManager(shopId) || isSuperAdmin())
                  : (isShopMember(shopId) || isSuperAdmin())
              )
        );
        allow create, update: if (
          ((isShopOwner(shopId) && isShopSubscriptionActive(shopId)) || isSuperAdmin()) ||
          (
            isShopSalesman(shopId) &&
            isShopSubscriptionActive(shopId) &&
            !(docId in ['owners', 'owner_txs', 'z_reports', 'monthly_audits', 'trash', 'store_config', 'audit_logs', 'api_config', 'private_costs', 'ownerTxs', 'monthlyAudits'])
          )
        ) && request.resource.data.shopId == shopId;
        allow delete: if isShopOwner(shopId) || isSuperAdmin();
      }
    }
  }
}
